# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only used in server-side code (route handlers, server actions) - never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Resend (order notification emails)
RESEND_API_KEY=

# Cloudinary (photo storage for the site editor)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
